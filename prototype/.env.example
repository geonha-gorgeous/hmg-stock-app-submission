# Copy to .env.local; never commit credentials. Use paper-trading keys only.
BROKER_PROVIDER=demo
BROKER_ENV=paper
API_PORT=4176
APP_ORIGINS=http://127.0.0.1:4174,http://localhost:4174

# Set BROKER_PROVIDER=kis for Korea Investment paper trading.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_PRODUCT=01

# Set BROKER_PROVIDER=kiwoom for Kiwoom paper trading.
# Register this server's public egress IP in Kiwoom before authentication.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
